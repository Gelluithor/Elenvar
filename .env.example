# --- Network and HTTPS ----------------------------------------------------------
# Address(es) Elenvar will be reachable on (comma-separated).
ELENVAR_DOMAIN=localhost
# "internal" = certificate from Caddy's internal CA (good for a LAN),
# or an e-mail address for an automatic Let's Encrypt certificate (public domain).
ELENVAR_TLS=internal
ELENVAR_HTTP_PORT=80
ELENVAR_HTTPS_PORT=443

# --- Administrator (used only on the first start) -------------------------------
ELENVAR_ADMIN_USERNAME=admin
# If left empty, a password is generated and printed to the log (docker compose logs app).
ELENVAR_ADMIN_PASSWORD=

# --- Sessions -------------------------------------------------------------------
# Sign-out after inactivity (minutes) and maximum session length (hours).
ELENVAR_SESSION_IDLE_MINUTES=60
ELENVAR_SESSION_MAX_HOURS=12

# --- Other ----------------------------------------------------------------------
TZ=Europe/Prague
ELENVAR_LOG_LEVEL=INFO
# Encryption key for NVR passwords. Empty = generated into the data volume.
# ELENVAR_SECRET_KEY=
# Recording playback: "rtsp" (default) or "ffmpeg" (for problematic firmware).
ELENVAR_PLAYBACK_SOURCE=rtsp
# Development only, without HTTPS: ELENVAR_COOKIE_SECURE=false

# --- Updates ----------------------------------------------------------------------
# Where new versions come from (Docker images and the list of GitHub releases).
# ELENVAR_IMAGE=ghcr.io/gelluithor/elenvar
# ELENVAR_UPDATER_IMAGE=ghcr.io/gelluithor/elenvar-updater
# ELENVAR_IMAGE_TAG=latest
# ELENVAR_UPDATE_REPO=Gelluithor/Elenvar

# --- Reverse proxy ------------------------------------------------------------------
# Proxies whose X-Forwarded-For header is trusted (IP addresses or CIDR ranges,
# comma-separated). Default "*" is safe with the bundled Caddy, because only Caddy
# can reach the app. Behind Traefik, set the Traefik address – see the README.
# ELENVAR_TRUSTED_PROXIES=*

# --- Traefik (only with docker-compose.traefik.yml) ---------------------------------
# ELENVAR_TRAEFIK_HOST=cameras.example.com
# ELENVAR_TRAEFIK_NETWORK=traefik
# ELENVAR_TRAEFIK_ENTRYPOINT=websecure
# ELENVAR_TRAEFIK_CERTRESOLVER=letsencrypt
