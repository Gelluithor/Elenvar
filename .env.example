# --- Síť a HTTPS ---------------------------------------------------------------
# Adresa(y), pod kterými bude Elenvar dostupný (odděleno čárkou).
ELENVAR_DOMAIN=localhost
# "internal" = certifikát od interní CA Caddy (vhodné pro LAN),
# nebo e-mail pro automatický certifikát Let's Encrypt (veřejná doména).
ELENVAR_TLS=internal
ELENVAR_HTTP_PORT=80
ELENVAR_HTTPS_PORT=443

# --- Administrátor (použije se jen při prvním startu) ---------------------------
ELENVAR_ADMIN_USERNAME=admin
# Pokud heslo nevyplníte, vygeneruje se a vypíše do logu (docker compose logs app).
ELENVAR_ADMIN_PASSWORD=

# --- Relace ---------------------------------------------------------------------
# Odhlášení po nečinnosti (minuty) a maximální délka přihlášení (hodiny).
ELENVAR_SESSION_IDLE_MINUTES=60
ELENVAR_SESSION_MAX_HOURS=12

# --- Ostatní --------------------------------------------------------------------
TZ=Europe/Prague
ELENVAR_LOG_LEVEL=INFO
# Šifrovací klíč pro hesla k NVR. Prázdný = vygeneruje se do datového svazku.
# ELENVAR_SECRET_KEY=
# Přehrávání záznamů: "rtsp" (výchozí) nebo "ffmpeg" (pro problematické firmwary).
ELENVAR_PLAYBACK_SOURCE=rtsp
# Pouze pro vývoj bez HTTPS: ELENVAR_COOKIE_SECURE=false

# --- Aktualizace -----------------------------------------------------------------
# Odkud se stahují nové verze (obrazy Docker a seznam vydání na GitHubu).
# ELENVAR_IMAGE=ghcr.io/gelluithor/elenvar
# ELENVAR_UPDATER_IMAGE=ghcr.io/gelluithor/elenvar-updater
# ELENVAR_IMAGE_TAG=latest
# ELENVAR_UPDATE_REPO=Gelluithor/Elenvar
