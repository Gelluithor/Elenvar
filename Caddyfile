{
	admin off
	skip_install_trust
}

# ELENVAR_DOMAIN: one or more comma-separated addresses, e.g. "elenvar.example.com"
# or "localhost, 192.168.1.20". ELENVAR_TLS: "internal" (Caddy's own certificate
# authority) or an e-mail address for an automatic Let's Encrypt certificate.
{$ELENVAR_DOMAIN} {
	tls {$ELENVAR_TLS}

	encode zstd gzip

	reverse_proxy app:8000 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
	}

	header {
		-Server
	}

	log {
		output stdout
		format console
	}
}
